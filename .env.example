# --- Public maintenance (anonymous visitors only) ---
# Logic is in `src/lib/maintenanceMode.ts`:
# - **Local dev (`npm run dev`)**: maintenance is OFF unless you set `VITE_MAINTENANCE_MODE=true`
#   (use that to test the coming-soon page locally).
# - **Production build (`vite build`)**: maintenance is ON unless the bundle was built with
#   `VITE_MAINTENANCE_MODE=false` (explicit “public site open” release).
# Values: only `true` or `false` are recognized; anything else follows the defaults above.
# Vite inlines at build time — changing Vercel env requires a new deploy for production bundles.
#
# Local: full app by default (omit or false)
# VITE_MAINTENANCE_MODE=false
#
# Local: test maintenance UI
# VITE_MAINTENANCE_MODE=true
#
# Optional internal preview / Playwright: same value as `?jf_maintenance_bypass=...` for one tab.
# Do not set a bypass token in production public builds if you want zero anonymous unlock surface.
# VITE_MAINTENANCE_BYPASS_TOKEN=playwright-maintenance-bypass

# Supabase (browser). When unset, signals/opportunities/content/performance/learning use
# in-memory stores + demo brands. When set, UUID workspace tenants persist to Postgres (RLS).
# Training (/training, dashboard widget) requires the training migrations applied to THIS project:
# see docs/TRAINING_SCHEMA_DEPLOYMENT.md and scripts/verify-training-schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: POST endpoint that returns a JSON `TrainingKnowledgeSpec` (same shape as client heuristic spec).
# When unset, training plans use the in-browser heuristic knowledge engine (still validated before RPC insert).
# VITE_TRAINING_KNOWLEDGE_URL=https://example.com/api/training-knowledge-spec

# INTERNAL UAT: required when Supabase env is set (workspace mode).
# `mock` = local demo generator.
# `http` = try Edge Function first, auto-fallback to mock when backend is not ready/healthy.
VITE_CONTENT_MODE=mock
VITE_SIGNAL_MODE=mock

# Optional: watchdog for cold-start auth.getSession() in ms (default 10000, min 3000, max 120000).
# VITE_AUTH_GET_SESSION_TIMEOUT_MS=

# Optional: override the fixed tenant id used for local dev without Supabase.
# VITE_LOCAL_DEV_TENANT_ID=

# Content generation (server-side). Point at your Edge Function; caption/hashtag JSON is returned.
# Example: https://<project-ref>.supabase.co/functions/v1/generate-content
# When unset, the app uses the in-browser mock generator (no network).
VITE_CONTENT_API_URL=

# Optional: force HTTP adapter when URL is omitted (URL still required at request time).
# VITE_CONTENT_GENERATION_MODE=http

# Legacy alias for VITE_SIGNAL_MODE (mock | remote).
# VITE_SIGNAL_PROVIDER_MODE=mock

# Optional: remote signal aggregate (required when VITE_SIGNAL_MODE=remote).
# VITE_SIGNAL_INGESTION_URL=

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets, not in Vite):
# OPENAI_API_KEY — when present, generate-content health reports ready=true and uses provider output.
# If missing, health reports ready=false and frontend auto-falls back to preview/mock.
# OPENAI_MODEL — optional, default gpt-4o-mini
# GENERATION_PRODUCTION=true — OpenAI failures return HTTP 503 { reason }; no server mock body (set on hosted env).
# Public endpoint: /functions/v1/generate-public uses the same OPENAI_* secrets with strict anonymous limits.

# INTERNAL UAT / debug: show DB catalog health banner when signed in (requires migration `uat_db_health_check`).
# VITE_INTERNAL_UAT_DIAGNOSTICS=true

# --- Access / IA (navigation hints; enforce permissions on the server) ---
# Production source of truth: `public.my_effective_access_tier` + `profiles.global_access_tier` /
# `tenant_members.role` (see migration `20260430120000_access_tier_rpc_and_hardening.sql`).
# Comma-separated lower-case emails — used only when RPC is unavailable or when email fallback is on.
# Precedence: super > platform > workspace > pro > member.
# VITE_SUPER_ADMIN_EMAILS=
# VITE_PLATFORM_ADMIN_EMAILS=
# VITE_WORKSPACE_ADMIN_EMAILS=
# VITE_PRO_USER_EMAILS=
# When true, or in dev unless set to false: use email lists above if the tier RPC fails or is missing.
# VITE_ACCESS_TIER_EMAIL_FALLBACK=true
# Optional overrides (staging / local): force tool surfaces without email lists.
# VITE_FORCE_PRO_TOOLS=true
# VITE_FORCE_PLATFORM_TOOLS=true
# Dev-only: opt-in to show Pro Lab / Platform nav without email lists (defaults off).
# VITE_DEV_SHOW_PRO_TOOLS=true
# VITE_DEV_SHOW_PLATFORM_TOOLS=true

# --- Live UAT automation (scripts + Playwright; never commit real secrets) ---
# Required for live UAT / provisioning so scripts cannot hit the wrong Supabase project by mistake:
# JIFUNZE_UAT_SUPABASE_PROJECT_REF=<project-ref>
# Optional escape hatch for local Supabase / sandboxes (use sparingly):
# JIFUNZE_ALLOW_UAT_NONMATCH=1
# `npm run uat:smoke` — API smoke: sign in, bootstrap workspace, brand insert, learning_snapshots.
# `npm run uat:provision` — writes `.env.smoke.local` with disposable or provided SMOKE_* credentials.
# `npm run test:e2e:live-uat` — browser UAT against real Supabase (loads `.env` + `.env.smoke.local`).
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
# Optional: server-only service role for `uat:provision` when email confirmation would block anon signUp.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Autonomous content loop / video pipeline
# See docs/video-pipeline.md. Everything here is OPTIONAL: with none of it set,
# `npm run autonomous:offline` still renders a designed evergreen video.
# ---------------------------------------------------------------------------
# VISUAL_PROVIDER — designed (default) | stock | fallback | ai
#   stock needs PEXELS_API_KEY, and silently falls back to designed without it.
#   fallback is the emergency flat gradient; never use it as a default.
# VISUAL_PROVIDER=designed
#
# PEXELS_API_KEY — free key from https://www.pexels.com/api/. Server-side only;
#   never import stockProvider from src/.
# PEXELS_API_KEY=
#
# DRY_RUN=true        render + write loop-artifacts/, publish nothing
# LOOP_OFFLINE=true   never contact Supabase (evergreen only)
# CONTENT_STRICT=false downgrade script-quality errors to warnings (not advised)
# RUN_DATE=2026-08-19 pin the evergreen rotation for a reproducible run
