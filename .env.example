# Supabase (browser). When unset, signals/opportunities/content/performance/learning use
# in-memory stores + demo brands. When set, UUID workspace tenants persist to Postgres (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# INTERNAL UAT: required when Supabase env is set (workspace mode).
# `mock` = local demo generator.
# `http` = try Edge Function first, auto-fallback to mock when backend is not ready/healthy.
VITE_CONTENT_MODE=mock
VITE_SIGNAL_MODE=mock

# Optional: watchdog for cold-start auth.getSession() in ms (default 10000, min 3000, max 120000).
# VITE_AUTH_GET_SESSION_TIMEOUT_MS=

# Optional: override the fixed tenant id used for local dev without Supabase.
# VITE_LOCAL_DEV_TENANT_ID=

# Content generation (server-side). Point at your Edge Function; caption/hashtag JSON is returned.
# Example: https://<project-ref>.supabase.co/functions/v1/generate-content
# When unset, the app uses the in-browser mock generator (no network).
VITE_CONTENT_API_URL=

# Optional: force HTTP adapter when URL is omitted (URL still required at request time).
# VITE_CONTENT_GENERATION_MODE=http

# Legacy alias for VITE_SIGNAL_MODE (mock | remote).
# VITE_SIGNAL_PROVIDER_MODE=mock

# Optional: remote signal aggregate (required when VITE_SIGNAL_MODE=remote).
# VITE_SIGNAL_INGESTION_URL=

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets, not in Vite):
# OPENAI_API_KEY — when present, generate-content health reports ready=true and uses provider output.
# If missing, health reports ready=false and frontend auto-falls back to preview/mock.
# OPENAI_MODEL — optional, default gpt-4o-mini
# GENERATION_PRODUCTION=true — OpenAI failures return HTTP 503 { reason }; no server mock body (set on hosted env).

# INTERNAL UAT / debug: show DB catalog health banner when signed in (requires migration `uat_db_health_check`).
# VITE_INTERNAL_UAT_DIAGNOSTICS=true
