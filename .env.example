# Jifunze.ai — environment variables
#
# Post-pivot (Amendment 003, 2026-08-21): Jifunze is an Instagram-first social learning media
# system. The learning platform and its billing/UAT variables are gone. Full reference for the
# engine's server-side variables: docs/social/ENVIRONMENT_VARIABLES.md.
# NEVER put a real secret in this file or in any VITE_* variable — VITE_* values are compiled
# into the public browser bundle.

# --- Public maintenance (anonymous visitors only) ---
# Logic in `src/lib/maintenanceMode.ts`:
# - Local dev (`npm run dev`): maintenance OFF unless VITE_MAINTENANCE_MODE=true.
# - Production build (`vite build`): maintenance ON unless built with VITE_MAINTENANCE_MODE=false.
# There is NO client-side maintenance bypass token; authenticated admins are exempt by design.
# VITE_MAINTENANCE_MODE=false

# --- Supabase (browser; anon key only — the service-role key must NEVER appear here) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional watchdog for cold-start auth.getSession() in ms (default 10000, min 3000, max 120000).
# VITE_AUTH_GET_SESSION_TIMEOUT_MS=

# --- Client runtime modes (public; validated in `src/lib/envCheck.ts`) ---
# VITE_CONTENT_MODE — "mock" (default, no Edge Function calls) or "http".
# VITE_SIGNAL_MODE  — "mock" (default) or "remote".
VITE_CONTENT_MODE=mock
VITE_SIGNAL_MODE=mock

# --- Access / IA (navigation hints; enforce permissions on the server) ---
# Production source of truth: `public.my_effective_access_tier` + RLS `public.is_admin()`.
# Comma-separated lower-case emails — used only when the RPC is unavailable.
# VITE_SUPER_ADMIN_EMAILS=
# VITE_PLATFORM_ADMIN_EMAILS=
# VITE_ACCESS_TIER_EMAIL_FALLBACK=true

# ---------------------------------------------------------------------------
# Autonomous content loop / video pipeline (server-side / CI only — never VITE_*)
# See docs/video-pipeline.md and docs/social/ENVIRONMENT_VARIABLES.md.
# With none of it set, `npm run autonomous:offline` still renders an evergreen video.
# ---------------------------------------------------------------------------
# VISUAL_PROVIDER=designed        # designed (default) | stock | fallback | ai
# PEXELS_API_KEY=                 # optional, server-side only
# OPENAI_API_KEY=                 # optional, server-side only
# DRY_RUN=true                    # render + write loop-artifacts/, publish nothing (DEFAULT true in CI)
# LOOP_OFFLINE=true               # never contact Supabase (evergreen only)
# CONTENT_STRICT=false            # downgrade script-quality errors to warnings (not advised)
# RUN_DATE=2026-08-19             # pin the evergreen rotation for a reproducible run

# --- Publishing switches (documented, DISABLED; see docs/social/INCIDENT_AND_KILL_SWITCH.md) ---
# These live in GitHub Actions variables / Supabase Edge Function secrets, never in this file:
# IG_PUBLISH_ENABLED    (unset = publishing off)
# SOCIAL_SYNC_ENABLED   (unset = metrics sync off)
# PUBLISH_SECRET, INGEST_SECRET, IG_ACCESS_TOKEN, IG_USER_ID (Supabase secrets only)
