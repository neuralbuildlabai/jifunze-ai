.env
.env.*
!.env.example
.env.smoke.local
.env.localy

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright demo recordings (large); keep folders via .gitkeep
e2e/demo-artifacts/videos/*.webm
e2e/demo-artifacts/screenshots/*.png

# Playwright test runner output
/playwright-report/
/test-results/
.vercel
.env*.local

# Supabase CLI cache (local only)
supabase/.temp/

# --- Autonomous content loop: generated media -------------------------------
# The loop writes its render, poster frame and decision.json here. These are CI
# artifacts (uploaded by .github/workflows/autonomous-loop.yml), never commits.
/loop-artifacts/
/out/
/output/
/renders/
/videos/
/tmp/

# Rendered video is never committed — it ships as a workflow artifact or via
# Supabase Storage. Keep source art (png/svg) tracked.
*.mp4
*.mov
*.webm
_xfer/

# --- Never-commit local scratch / transfer / quarantine areas ------------------
# `_to_delete/` has held a source transfer archive that packaged a real `.env.local`.
# Keep it out of the index so no `git add -A` can ever stage secrets from it.
_to_delete/
# FUSE mount leftovers from in-place edits of open files (transient, never source).
.fuse_hidden*
