{
  "name": "jifunze-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsx scripts/test-content-engine.ts",
    "test:content-engine": "tsx scripts/test-content-engine.ts",
    "social:sync": "tsx scripts/social-sync.ts",
    "social:sync:dry-run": "tsx scripts/social-sync.ts --dry-run",
    "social:test": "tsx scripts/test-social-ops.ts",
    "social:verify-migration": "bash scripts/verify-social-ops-migration.sh",
    "seo:generate": "tsx scripts/generate-public-seo.ts",
    "guides:generate": "tsx scripts/generate-guides.ts > src/social/guides.ts",
    "test:security": "tsx scripts/test-client-secret-boundary.ts",
    "test:all": "npm run test && npm run social:test && npm run test:security && npm run test:role-routing",
    "typecheck:pipeline": "tsc -p tsconfig.pipeline.json",
    "video:dry-run": "tsx scripts/video-dry-run.ts",
    "video:test-news-gate": "tsx scripts/test-news-gate.ts",
    "video:evergreen": "tsx scripts/video-render-sample.ts",
    "video:render:designed": "VISUAL_PROVIDER=designed tsx scripts/video-render-sample.ts",
    "video:render:stock": "VISUAL_PROVIDER=stock tsx scripts/video-render-sample.ts",
    "video:daily": "npm run autonomous:once",
    "video:brand-bg": "node scripts/generate-brand-bg.mjs",
    "autonomous:dry-run": "DRY_RUN=true tsx orchestrator/run.ts",
    "autonomous:offline": "LOOP_OFFLINE=true DRY_RUN=true tsx orchestrator/run.ts",
    "autonomous:once": "tsx orchestrator/run.ts",
    "autonomous:validate": "npm run test && npm run lint && npm run typecheck:pipeline && npm run build",
    "test:e2e": "playwright test",
    "test:role-routing": "tsx scripts/test-role-default-routes.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
