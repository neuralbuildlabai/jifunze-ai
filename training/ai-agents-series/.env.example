# Copy this file to .env in the episode folder you're running.
# Both providers are optional individually, but Episode 3 references both for comparison.

# Required for OpenAI-based examples (default).
OPENAI_API_KEY=your_openai_key_here

# Optional. Used in Episode 3's provider-comparison section.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional. If you want Episode 1 to use a real web search rather than DuckDuckGo
# Instant Answers (which is mostly Wikipedia summaries and is empty for many queries),
# create a free Tavily account and paste the key here.
TAVILY_API_KEY=
